local function myHRP()
    local c = LocalPlayer.Character
    if c then
        return c:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function monsterRoot(m)
    if not m then return nil end
    local r = m:FindFirstChild("HumanoidRootPart")
    if r then return r end
    r = m:FindFirstChild("Torso")
    if r then return r end
    r = m:FindFirstChild("Head")
    if r then return r end
    for _, v in m:GetDescendants() do
        if v:IsA("BasePart") then
            return v
        end
    end
    return nil
end

local function getGranny()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if (obj:IsA("Folder") or obj:IsA("Model")) and string.match(obj.Name, "^Preset%d+$") then
            local locks = obj:FindFirstChild("Locks")
            if locks then
                local g = locks:FindFirstChild("Granny")
                if g then return g end
            end
        end
    end
    return nil
end

local espOn = false
local espTags = {} -- [model] = {hl, gui, label}

local function clearEsp()
    for m, t in pairs(espTags) do
        pcall(function() t.hl:Destroy() end)
        pcall(function() t.gui:Destroy() end)
    end
    espTags = {}
end

local function addEsp(m, color)
    if espTags[m] then return end
    local root = monsterRoot(m)
    if not root then return end

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then
        pg = LocalPlayer:WaitForChild("PlayerGui")
    end

    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.FillColor = color
    hl.Adornee = m
    hl.Parent = pg

    local bb = Instance.new("BillboardGui")
    bb.Adornee = root
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = pg

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.GothamBold
    txt.TextScaled = true
    txt.Text = m.Name
    txt.Parent = bb

    espTags[m] = { hl = hl, gui = bb, label = txt }
end

