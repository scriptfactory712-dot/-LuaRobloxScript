local WAIT_BEFORE_FIRE = 0.3
local WAIT_BEFORE_BACK = 0.15

local function findActivePreset()
    for _, obj in Workspace:GetChildren() do
        if (obj:IsA("Folder") or obj:IsA("Model")) and string.match(obj.Name, "^Preset%d+$") then
            return obj
        end
    end
    return nil
end

local function findActivePaintingPreset()
    for _, obj in Workspace:GetChildren() do
        if (obj:IsA("Folder") or obj:IsA("Model")) and string.match(obj.Name, "^PaintingPreset%d+$") then
            return obj
        end
    end
    return nil
end

local function getItemCFrame(itemObj)
    if itemObj:IsA("BasePart") then
        return itemObj.CFrame
    elseif itemObj:IsA("Model") then
        local ok, pivot = pcall(function() return itemObj:GetPivot() end)
        if ok and pivot then return pivot end
        local primary = itemObj.PrimaryPart
        if primary then return primary.CFrame end
        for _, d in itemObj:GetDescendants() do
            if d:IsA("BasePart") then return d.CFrame end
        end
    else
        for _, d in itemObj:GetDescendants() do
            if d:IsA("BasePart") then return d.CFrame end
        end
    end
    return nil
end

local function findPresetItem(preset, itemName)
    local direct = preset:FindFirstChild(itemName)
    if direct then return direct end

    local lowerName = string.lower(itemName)
    for _, obj in preset:GetDescendants() do
        if obj.Name == "Toolname" and obj:IsA("StringValue") then
            if string.lower(obj.Value) == lowerName then
                return obj.Parent
            end
        end
    end
    return nil
end

local function grabItem(itemObj, label)
    label = label or itemObj.Name
    local remote = itemObj:FindFirstChild("InteractRemote")
    if not remote then
        print("[Item Giver] No InteractRemote on " .. label)
        return false
    end

    local targetCF = getItemCFrame(itemObj)
    if not targetCF then
        print("[Item Giver] No position for " .. label)
        return false
    end

    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local originalCFrame = hrp.CFrame

    hrp.CFrame = targetCF + Vector3.new(0, 2, 0)

    local interactAvailable = remote:FindFirstChild("InteractAvailable")
    if interactAvailable then
        interactAvailable.Value = true
    end

    task.wait(WAIT_BEFORE_FIRE)

    remote:FireServer(LocalPlayer)
    task.wait(0.05)
    remote:FireServer(LocalPlayer)

    task.wait(WAIT_BEFORE_BACK)
    if hrp and hrp.Parent then
        hrp.CFrame = originalCFrame
        task.wait(0.5)
        if hrp and hrp.Parent then
            local cur = hrp.CFrame
            local diff = (cur.Position - originalCFrame.Position).Magnitude
            if diff > 5 then
                hrp.CFrame = originalCFrame
            end
        end
    end
    return true
end

local function getWithPath(itemPath)
    local parts = string.split(itemPath, ".")
    local current = game
    for _, part in parts do
        current = current:FindFirstChild(part)
        if not current then return nil end
    end
    return current
end

